{
  "name": "@bohemia/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "skeleton-check": "tsx scripts/skeleton-check.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../../.gitignore",
    "format": "prettier --write . --ignore-path ../../.gitignore",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@bohemia/db": "*",
    "@bohemia/game": "*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
