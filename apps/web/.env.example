# Vzor proměnných pro apps/web/.env.local (ten je mimo git – repo je veřejné).

# --- Účty (Better Auth) ---
# Tajemství pro podepisování session a odkazů: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3010

# Přihlášení přes Google – OAuth klient z Google Cloud Console.
# Redirect URI: http://localhost:3010/api/auth/callback/google
# Bez nich se tlačítko Google nezobrazí.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Databáze ---
# Lokálně není potřeba – bez ní se použije postgres://postgres@127.0.0.1:5432/bohemia.
# DATABASE_URL=

# --- Testovací svět ---
# Bez těchto proměnných běží ostrý svět (1. 1. 2027 – 1. 1. 2028).
# Zadávají se vždy obě, ve formátu ISO 8601. Svět musí trvat aspoň 365250 ms (≈ 6 minut).
#
# Svět od dneška ve skutečném tempu (rok ≈ 8 h 46 min):
#   WORLD_START=2026-10-16T12:00:00+02:00
#   WORLD_END=2027-10-16T12:00:00+02:00
#
# Zrychlený svět – 1000 let za 2 dny (rok ≈ 2 min 53 s, den ≈ 0,5 s):
#   WORLD_START=2026-10-16T12:00:00+02:00
#   WORLD_END=2026-10-18T12:00:00+02:00
WORLD_START=
WORLD_END=
