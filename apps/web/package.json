{
  "name": "@bohemia/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "start": "next start --port 3010",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../../.gitignore",
    "format": "prettier --write . --ignore-path ../../.gitignore",
    "test": "vitest run --passWithNoTests --testTimeout=30000",
    "test:e2e": "playwright test",
    "seed:dev": "tsx scripts/seed-dev-user.ts",
    "test:e2e:worker": "playwright test --project=worker"
  },
  "dependencies": {
    "@babylonjs/core": "^9.31.0",
    "@babylonjs/loaders": "^9.31.0",
    "@bohemia/db": "*",
    "@bohemia/game": "*",
    "@bohemia/server": "*",
    "better-auth": "^1.7.10",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "simplex-noise": "4.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
