# Vzor proměnných workeru. Worker čte i apps/web/.env.local (DATABASE_URL, WORLD_START, WORLD_END,
# WORLD_SEED musí být stejné jako ve webu); proměnné z prostředí mají přednost. Repo je veřejné – žádná tajemství.

# Lokálně není potřeba – bez ní se použije postgres://postgres@127.0.0.1:5432/bohemia.
# DATABASE_URL=

# Nejvýš o tolik herních dní posune dávka jednu ves (výchozí 10).
# WORKER_STEP_DAYS=10
# Nejvýš tolik hráčů za kolo (výchozí 50).
# WORKER_LIMIT=50
# Nejdéle (ms) spí worker, když není co počítat (výchozí 5000).
# WORKER_IDLE_MS=5000
# Pauza (ms) mezi koly, když je práce pozadu (výchozí 20).
# WORKER_PAUSE_MS=20
# Kolik krajin sídel držet v paměti (výchozí 128, ≈ 250 MB).
# WORKER_LANDSCAPES=128
# Úroveň logu: info (souhrn za minutu) nebo debug (i každá dávka hráče).
# WORKER_LOG=info
